<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #F8F9FA;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.rplbo.app.demo.CutiController">
    <children>
        <VBox spacing="20.0" style="-fx-background-color: #FFFDF4; -fx-border-color: #4EA3E3; -fx-border-width: 3;" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="15.0" />
            </padding>
            <children>

                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <HBox spacing="5.0">
                            <children>
                                <AnchorPane prefHeight="10.0" prefWidth="10.0" style="-fx-background-color: #FF5F56; -fx-background-radius: 5;" />
                                <AnchorPane prefHeight="10.0" prefWidth="10.0" style="-fx-background-color: #FFBD2E; -fx-background-radius: 5;" />
                                <AnchorPane prefHeight="10.0" prefWidth="10.0" style="-fx-background-color: #27C93F; -fx-background-radius: 5;" />
                            </children>
                        </HBox>
                        <Label text="Aplikasi Manajemen Presensi — Formulir Pengajuan Cuti / Izin" textFill="#7A7A7A">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                            <HBox.margin>
                                <Insets left="10.0" />
                            </HBox.margin>
                        </Label>
                    </children>
                </HBox>

                <HBox alignment="CENTER" spacing="15.0">
                    <children>
                        <Button fx:id="btnKembaliDashboard" mnemonicParsing="false" onAction="#handleKembaliDashboard" prefWidth="180.0" style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-background-radius: 15; -fx-cursor: hand;" text="← Kembali ke Dashboard">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnAjukanBaru" mnemonicParsing="false" prefWidth="180.0" style="-fx-background-color: #D2E3FC; -fx-text-fill: #1967D2; -fx-border-color: #AECBFA; -fx-border-radius: 15; -fx-background-radius: 15; -fx-cursor: hand;" text="Ajukan Baru">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnRiwayatPengajuan" mnemonicParsing="false" prefWidth="180.0" style="-fx-background-color: #F1F3F4; -fx-text-fill: #5F6368; -fx-border-color: #BDC1C6; -fx-border-radius: 15; -fx-background-radius: 15; -fx-cursor: hand;" text="Riwayat Pengajuan" />
                    </children>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </HBox>

                <VBox spacing="15.0">
                    <children>
                        <VBox spacing="5.0">
                            <children>
                                <Label text="Jenis Ketidakhadiran" textFill="#5F6368">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <HBox spacing="15.0">
                                    <children>
                                        <ToggleButton fx:id="btnCutiTahunan" mnemonicParsing="false" prefHeight="35.0" prefWidth="130.0" style="-fx-background-color: #D2E3FC; -fx-text-fill: #1967D2; -fx-border-color: #AECBFA; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand;" text="Cuti Tahunan">
                                            <toggleGroup>
                                                <ToggleGroup fx:id="jenisCutiGroup" />
                                            </toggleGroup>
                                            <font>
                                                <Font name="System Bold" size="12.0" />
                                            </font>
                                        </ToggleButton>
                                        <ToggleButton fx:id="btnIzinSakit" mnemonicParsing="false" prefHeight="35.0" prefWidth="130.0" style="-fx-background-color: #FCE8E6; -fx-text-fill: #C5221F; -fx-border-color: #FAD2CF; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand;" text="Izin Sakit" toggleGroup="$jenisCutiGroup">
                                            <font>
                                                <Font name="System Bold" size="12.0" />
                                            </font>
                                        </ToggleButton>
                                        <ToggleButton fx:id="btnKeperluanLain" mnemonicParsing="false" prefHeight="35.0" prefWidth="130.0" style="-fx-background-color: #F1F3F4; -fx-text-fill: #5F6368; -fx-border-color: #BDC1C6; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand;" text="Keperluan Lain" toggleGroup="$jenisCutiGroup">
                                            <font>
                                                <Font name="System Bold" size="12.0" />
                                            </font>
                                        </ToggleButton>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <GridPane hgap="20.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" prefHeight="25.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <Label text="Tanggal Mulai" textFill="#5F6368">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <Label text="Tanggal Selesai" textFill="#5F6368" GridPane.columnIndex="1">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <DatePicker fx:id="dpTanggalMulai" maxWidth="1.1797693134862315E308" style="-fx-background-color: transparent; -fx-border-color: #BDC1C6; -fx-border-radius: 5;" GridPane.rowIndex="1" />
                                <DatePicker fx:id="dpTanggalSelesai" maxWidth="1.1797693134862315E308" style="-fx-background-color: transparent; -fx-border-color: #BDC1C6; -fx-border-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                            </children>
                        </GridPane>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Keterangan / Alasan" textFill="#5F6368">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <TextArea fx:id="txtKeterangan" prefHeight="100.0" promptText="Tuliskan alasan secara detail..." style="-fx-border-color: #BDC1C6; -fx-border-radius: 5; -fx-background-color: transparent;" wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                    <VBox.margin>
                        <Insets left="40.0" right="40.0" />
                    </VBox.margin>
                </VBox>

                <VBox alignment="CENTER" spacing="12.0">
                    <children>
                        <Button fx:id="btnKirimPengajuan" maxWidth="1.1797693134862315E308" mnemonicParsing="false" onAction="#handleKirimPengajuan" prefHeight="35.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #BDC1C6; -fx-border-radius: 5; -fx-background-radius: 5; -fx-text-fill: #202124; -fx-cursor: hand;" text="Kirim Pengajuan">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Button>
                        <HBox alignment="CENTER_LEFT" prefHeight="35.0" style="-fx-background-color: #FDF6E2; -fx-border-color: #F5E3B3; -fx-border-radius: 5; -fx-background-radius: 5;">
                            <children>
                                <Label fx:id="lblStatusPengajuan" text="⏳ Cuti 06 Apr 2026 — Menunggu Persetujuan" textFill="#B06000">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                    <HBox.margin>
                                        <Insets left="15.0" />
                                    </HBox.margin>
                                </Label>
                            </children>
                        </HBox>
                    </children>
                    <VBox.margin>
                        <Insets left="40.0" right="40.0" top="10.0" />
                    </VBox.margin>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>