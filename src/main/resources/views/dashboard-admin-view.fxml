<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1150.0" style="-fx-background-color: #F8F9FA;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.rplbo.app.demo.controllers.DashboardAdminController">

    <left>
        <VBox prefWidth="230.0" spacing="15" style="-fx-background-color: white; -fx-padding: 25; -fx-border-color: #E9ECEF; -fx-border-width: 0 1 0 0;">
            <Label fx:id="lblNamaAdmin" style="-fx-font-weight: bold; -fx-text-fill: #212529;" text="Admin S.">
                <font><Font size="18.0" /></font>
            </Label>
            <Label style="-fx-text-fill: #6C757D;" text="Administrator" />
            <Separator />

            <Button fx:id="btnMenuKaryawan" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleMenuKaryawan" style="-fx-background-color: #E9ECEF; -fx-text-fill: #0D6EFD; -fx-font-weight: bold; -fx-cursor: hand;" text="👥 Manajemen Karyawan" />
            <Button fx:id="btnMenuCuti" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleMenuCuti" style="-fx-background-color: transparent; -fx-text-fill: #495057; -fx-cursor: hand;" text="🗓 Persetujuan Cuti" />
            <Button fx:id="btnMenuPresensi" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleMenuPresensi" style="-fx-background-color: transparent; -fx-text-fill: #495057; -fx-cursor: hand;" text="⏱ Edit Presensi" />
            <Button fx:id="btnMenuLaporan" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleMenuLaporan" style="-fx-background-color: transparent; -fx-text-fill: #495057; -fx-cursor: hand;" text="📊 Laporan &amp; Rekap" />

            <Region VBox.vgrow="ALWAYS" />
            <Button maxWidth="Infinity" onAction="#handleLogout" style="-fx-background-color: #DC3545; -fx-text-fill: white; -fx-background-radius: 8;" text="🚪 Keluar" />
        </VBox>
    </left>

    <center>
        <StackPane>
            <children>
                <VBox fx:id="paneKaryawanUtama" spacing="20.0" style="-fx-padding: 25;">
                    <VBox>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #212529;" text="Manajemen Data Karyawan (Sistem CRUD)"><font><Font size="22.0" /></font></Label>
                        <Label style="-fx-text-fill: #6C757D;" text="Kelola data akun dan identitas karyawan." />
                    </VBox>
                    <HBox spacing="20">
                        <VBox prefWidth="180" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10; -fx-border-color: #DEE2E6; -fx-border-radius: 10;">
                            <Label style="-fx-text-fill: #6C757D;" text="Total Karyawan" />
                            <Label fx:id="lblTotalKaryawan" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #212529;" text="0" />
                        </VBox>
                        <VBox prefWidth="180" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10; -fx-border-color: #DEE2E6; -fx-border-radius: 10;">
                            <Label style="-fx-text-fill: #6C757D;" text="Karyawan Aktif" />
                            <Label fx:id="lblKaryawanAktif" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #198754;" text="0" />
                        </VBox>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <TextField fx:id="txtCari" onKeyReleased="#handleCari" prefWidth="250.0" promptText="Cari nama karyawan..." style="-fx-background-radius: 8; -fx-padding: 8;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleTambah" style="-fx-background-color: #0D6EFD; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 15;" text="➕ Tambah Karyawan Baru" />
                    </HBox>
                    <TableView fx:id="tableKaryawan" onMouseClicked="#handleKlikTabel" style="-fx-background-radius: 8; -fx-border-color: #DEE2E6; -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colId" prefWidth="80.0" text="ID" />
                            <TableColumn fx:id="colNama" prefWidth="200.0" text="Nama Lengkap" />
                            <TableColumn fx:id="colNik" prefWidth="130.0" text="NIK" />
                            <TableColumn fx:id="colJabatan" prefWidth="120.0" text="ID Jabatan" />
                            <TableColumn fx:id="colEmail" prefWidth="180.0" text="Email" />
                            <TableColumn fx:id="colStatus" prefWidth="100.0" text="Status" />
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                    </TableView>
                </VBox>

                <VBox fx:id="paneCutiUtama" managed="false" spacing="20.0" style="-fx-padding: 25;" visible="false">
                    <VBox>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #212529;" text="Persetujuan Izin / Cuti Karyawan"><font><Font size="22.0" /></font></Label>
                        <Label style="-fx-text-fill: #6C757D;" text="Pilih baris data untuk menyetujui atau menolak permohonan." />
                    </VBox>
                    <TableView fx:id="tableCuti" onMouseClicked="#handleKlikTabelCuti" style="-fx-background-radius: 8; -fx-border-color: #DEE2E6; -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colCutiId" prefWidth="60.0" text="ID Izin" />
                            <TableColumn fx:id="colCutiNama" prefWidth="180.0" text="Nama Karyawan" />
                            <TableColumn fx:id="colCutiJenis" prefWidth="120.0" text="Jenis Izin" />
                            <TableColumn fx:id="colCutiMulai" prefWidth="120.0" text="Tgl Mulai" />
                            <TableColumn fx:id="colCutiSelesai" prefWidth="120.0" text="Tgl Selesai" />
                            <TableColumn fx:id="colCutiAlasan" prefWidth="250.0" text="Alasan / Keterangan" />
                            <TableColumn fx:id="colCutiStatus" prefWidth="120.0" text="Status" />
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                    </TableView>
                </VBox>

                <VBox fx:id="panePresensiUtama" managed="false" spacing="20.0" style="-fx-padding: 25;" visible="false">
                    <VBox>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #212529;" text="Manajemen Data Presensi"><font><Font size="22.0" /></font></Label>
                        <Label style="-fx-text-fill: #6C757D;" text="Sesuaikan rekaman presensi harian karyawan secara manual." />
                    </VBox>
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <DatePicker fx:id="dpFilterPresensi" promptText="Filter Tanggal..." />
                        <Button onAction="#handleFilterPresensi" style="-fx-background-color: #6C757D; -fx-text-fill: white; -fx-background-radius: 8;" text="Tampilkan" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text="*Klik baris tabel untuk mengubah data" textFill="#0D6EFD"><font><Font name="System Italic" size="12.0" /></font></Label>
                    </HBox>
                    <TableView fx:id="tableRekamanPresensi" onMouseClicked="#handleKlikTabelPresensi" style="-fx-background-radius: 8; -fx-border-color: #DEE2E6; -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colPresensiId" prefWidth="60.0" text="ID" />
                            <TableColumn fx:id="colPresensiNama" prefWidth="200.0" text="Nama Karyawan" />
                            <TableColumn fx:id="colPresensiTanggal" prefWidth="120.0" text="Tanggal" />
                            <TableColumn fx:id="colPresensiMasuk" prefWidth="100.0" text="Jam Masuk" />
                            <TableColumn fx:id="colPresensiKeluar" prefWidth="100.0" text="Jam Keluar" />
                            <TableColumn fx:id="colPresensiStatus" prefWidth="150.0" text="Status" />
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                    </TableView>
                </VBox>

                <VBox fx:id="paneLaporanUtama" managed="false" spacing="20.0" style="-fx-padding: 25;" visible="false">
                    <HBox alignment="CENTER_LEFT">
                        <VBox>
                            <Label style="-fx-font-weight: bold; -fx-text-fill: #212529;" text="Laporan &amp; Rekapitulasi Presensi"><font><Font size="22.0" /></font></Label>
                            <Label style="-fx-text-fill: #6C757D;" text="Ringkasan kehadiran, cuti, dan keterlambatan seluruh karyawan." />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleUnduhExcel" style="-fx-background-color: #198754; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-padding: 8 15;" text="📥 Unduh Data (Excel/CSV)" />
                    </HBox>

                    <TableView fx:id="tableLaporan" style="-fx-background-radius: 8; -fx-border-color: #DEE2E6; -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colLapNama" prefWidth="250.0" text="Nama Karyawan" />
                            <TableColumn fx:id="colLapJabatan" prefWidth="150.0" text="Jabatan" />
                            <TableColumn fx:id="colLapHadir" prefWidth="80.0" text="Hadir" />
                            <TableColumn fx:id="colLapTerlambat" prefWidth="80.0" text="Terlambat" />
                            <TableColumn fx:id="colLapCuti" prefWidth="80.0" text="Cuti" />
                            <TableColumn fx:id="colLapIzin" prefWidth="80.0" text="Izin/Sakit" />
                            <TableColumn fx:id="colLapAlpa" prefWidth="80.0" text="Alpa" />
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                    </TableView>
                </VBox>

            </children>
        </StackPane>
    </center>

    <right>
        <StackPane style="-fx-background-color: white; -fx-border-color: #E9ECEF; -fx-border-width: 0 0 0 1;">
            <children>
                <VBox fx:id="paneForm" managed="false" prefWidth="320.0" spacing="12.0" style="-fx-padding: 25;" visible="false">
                    <Label fx:id="lblJudulForm" style="-fx-font-weight: bold;" text="Formulir Karyawan"><font><Font size="16.0" /></font></Label>
                    <Separator />
                    <Label text="Nama Lengkap" /> <TextField fx:id="inputNama" />
                    <Label text="NIK" /> <TextField fx:id="inputNik" />
                    <Label text="ID Jabatan (Angka)" /> <TextField fx:id="inputJabatan" />
                    <Label text="ID Departemen (Angka)" /> <TextField fx:id="inputDepartemen" />
                    <Label text="Email" /> <TextField fx:id="inputEmail" />
                    <Label text="Status" />
                    <HBox spacing="15.0"><RadioButton fx:id="rbAktif" text="aktif" /><RadioButton fx:id="rbNonaktif" text="nonaktif" /></HBox>
                    <HBox spacing="10.0" style="-fx-padding: 15 0 0 0;">
                        <Button maxWidth="Infinity" onAction="#handleSimpan" style="-fx-background-color: #198754; -fx-text-fill: white;" text="Simpan" HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleBatal" text="Batal" />
                    </HBox>
                </VBox>

                <VBox fx:id="paneFormPresensi" managed="false" prefWidth="320.0" spacing="15.0" style="-fx-padding: 25;" visible="false">
                    <Label style="-fx-font-weight: bold;" text="Edit Rekaman Presensi"><font><Font size="16.0" /></font></Label>
                    <Separator />
                    <Label fx:id="lblEditNamaKaryawan" style="-fx-font-weight: bold;" text="Nama" textFill="#0D6EFD" />
                    <Label fx:id="lblEditTanggal" text="Tanggal" />
                    <HBox spacing="10">
                        <VBox HBox.hgrow="ALWAYS"><Label text="Jam Masuk" /><TextField fx:id="inputJamMasuk" promptText="08:00:00" /></VBox>
                        <VBox HBox.hgrow="ALWAYS"><Label text="Jam Keluar" /><TextField fx:id="inputJamKeluar" promptText="17:00:00" /></VBox>
                    </HBox>
                    <Label text="Status Kehadiran" />
                    <ComboBox fx:id="comboStatusKehadiran" maxWidth="Infinity" />
                    <Label text="Status Waktu" />
                    <ComboBox fx:id="comboStatusWaktu" maxWidth="Infinity" />
                    <HBox spacing="10.0" style="-fx-padding: 20 0 0 0;">
                        <Button maxWidth="Infinity" onAction="#handleSimpanPresensi" style="-fx-background-color: #0D6EFD; -fx-text-fill: white;" text="Simpan" HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleBatalPresensi" text="Batal" />
                    </HBox>
                </VBox>
            </children>
        </StackPane>
    </right>
</BorderPane>