<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER"
      spacing="20"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.rplbo.app.demo.RiwayatController"
      style="-fx-background-color: #F5F5F5;">

    <padding>
        <Insets top="25"
                right="30"
                bottom="25"
                left="30"/>
    </padding>

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT"
          prefWidth="900">

        <Label text="Riwayat Presensi">
            <font>
                <Font name="System Bold" size="24"/>
            </font>
        </Label>

        <Region HBox.hgrow="ALWAYS"/>

        <Label text="Filter:"
               style="-fx-font-size: 14px;"/>

        <ComboBox fx:id="cmbFilter"
                  prefWidth="140"
                  promptText="April 2026"/>

    </HBox>

    <!-- TABLE -->
    <VBox spacing="10"
          prefWidth="900"
          style="-fx-background-color: white;
                 -fx-background-radius: 12;
                 -fx-padding: 15;">

        <TableView fx:id="tableRiwayat"
                   prefHeight="350"
                   prefWidth="850">

            <columns>

                <!-- TANGGAL -->
                <TableColumn fx:id="colTanggal"
                             text="Tanggal"
                             prefWidth="150"/>

                <!-- MASUK -->
                <TableColumn fx:id="colMasuk"
                             text="Masuk"
                             prefWidth="150"/>

                <!-- KELUAR -->
                <TableColumn fx:id="colKeluar"
                             text="Keluar"
                             prefWidth="150"/>

                <!-- STATUS -->
                <TableColumn fx:id="colStatus"
                             text="Status"
                             prefWidth="250"/>

            </columns>

        </TableView>

    </VBox>

    <!-- REKAP -->
    <HBox spacing="15"
          alignment="CENTER">

        <!-- HADIR -->
        <VBox alignment="CENTER"
              prefWidth="220"
              prefHeight="90"
              spacing="5"
              style="-fx-background-color: #DFEAD2;
                     -fx-background-radius: 12;">

            <Label fx:id="lblTotalHadir"
                   text="0"
                   style="-fx-font-size: 28px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #2E7D32;"/>

            <Label text="Hadir"
                   style="-fx-text-fill: #2E7D32;"/>

        </VBox>

        <!-- TERLAMBAT -->
        <VBox alignment="CENTER"
              prefWidth="220"
              prefHeight="90"
              spacing="5"
              style="-fx-background-color: #F3E7D3;
                     -fx-background-radius: 12;">

            <Label fx:id="lblTerlambat"
                   text="0"
                   style="-fx-font-size: 28px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #8D6E63;"/>

            <Label text="Terlambat"
                   style="-fx-text-fill: #8D6E63;"/>

        </VBox>

        <!-- IZIN -->
        <VBox alignment="CENTER"
              prefWidth="220"
              prefHeight="90"
              spacing="5"
              style="-fx-background-color: #D9E7F7;
                     -fx-background-radius: 12;">

            <Label fx:id="lblIzin"
                   text="0"
                   style="-fx-font-size: 28px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #1565C0;"/>

            <Label text="Izin/Cuti"
                   style="-fx-text-fill: #1565C0;"/>

        </VBox>

    </HBox>

    <!-- BUTTON -->
    <Button text="⬅ Kembali ke Dashboard"
            onAction="#handleKembaliDashboard"
            prefWidth="250"
            prefHeight="45"
            style="-fx-background-color: #1976D2;
                   -fx-text-fill: white;
                   -fx-font-size: 16px;
                   -fx-background-radius: 10;"/>

</VBox>